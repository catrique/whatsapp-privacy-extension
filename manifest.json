{
  "manifest_version": 3,
  "name": "WhatsApp Privacy",
  "version": "1.1.0",
  "description": "Adiciona uma camada simples de privacidade ao WhatsApp Web.",
  "incognito": "spanning",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "css": ["style.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
